# Schutz-Header für alle Seiten
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; frame-src https://www.youtube-nocookie.com https://www.openstreetmap.org https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Das Redaktionssystem braucht Zugriff auf GitHub und eigene Regeln
/admin/*
  ! Content-Security-Policy
  X-Robots-Tag: noindex

# Mitgliederbereich: nicht in Suchmaschinen, nicht in Zwischenspeichern
/mitglieder/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: private, no-store

# Vorläufige Cloudflare-Adressen nicht in Suchmaschinen aufnehmen
https://:worker.:konto.workers.dev/*
  X-Robots-Tag: noindex
