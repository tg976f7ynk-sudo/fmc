---
import { alleTermine, isoTag } from '../lib/inhalte';

interface Props { modus?: 'kommend' | 'alle'; anzahl?: number; }
const { modus = 'alle', anzahl = 0 } = Astro.props;
const termine = await alleTermine();
const tag = new Intl.DateTimeFormat('de-DE', { weekday: 'short', timeZone: 'UTC' });
const kurz = (d: Date) => `${tag.format(d).replace('.', '').toUpperCase()} ${String(d.getUTCDate()).padStart(2, '0')}.${String(d.getUTCMonth() + 1).padStart(2, '0')}.${String(d.getUTCFullYear()).slice(2)}`;
const bisText = (von: Date, bis?: Date | null) => (bis && isoTag(bis) > isoTag(von) ? `bis ${String(bis.getUTCDate()).padStart(2, '0')}.${String(bis.getUTCMonth() + 1).padStart(2, '0')}.` : '');
---

<div class="terminliste" data-modus={modus} data-anzahl={anzahl}>
  <div class="tafel">
    <div class="tafel-kopf" aria-hidden="true"><span>Datum</span><span>Zeit</span><span>Veranstaltung</span><span>Ort</span><span style="text-align:right">Status</span></div>
    <ul class="termine" data-kommend>
      {
        termine.map((t) => (
          <li class="termin" data-von={isoTag(t.data.datum)} data-bis={isoTag(t.data.ende ?? t.data.datum)} data-zeit={t.data.uhrzeit ?? ""} data-titel={t.data.titel}>
            <span class="termin-datum">{kurz(t.data.datum)}</span>
            <span class="termin-zeit">{[bisText(t.data.datum, t.data.ende), t.data.uhrzeit].filter(Boolean).join(' · ')}</span>
            <span class="termin-was">
              {t.data.link ? <a href={t.data.link}>{t.data.titel}</a> : t.data.titel}
              {t.data.beschreibung && <small>{t.data.beschreibung}</small>}
            </span>
            <span class="termin-ort">{t.data.ort}</span>
            <span class="termin-status" data-status>Geplant</span>
          </li>
        ))
      }
    </ul>
    <p class="leer" data-leer hidden>Zurzeit sind keine kommenden Termine eingetragen.</p>
  </div>
  {
    modus === 'alle' && (
      <details class="vergangen" data-vergangen-box hidden>
        <summary>Vergangene Termine anzeigen</summary>
        <ul class="termine" data-vergangen />
      </details>
    )
  }
</div>

<script>
  // Welche Termine "kommend" sind, entscheidet das Datum des Besuchers –
  // so stimmt die Tafel auch ohne tägliche Neuveröffentlichung.
  const heute = new Date().toLocaleDateString('sv-SE', { timeZone: 'Europe/Berlin' });
  document.querySelectorAll<HTMLElement>('.terminliste').forEach((box) => {
    const kommend = box.querySelector<HTMLElement>('[data-kommend]')!;
    const vergangen = box.querySelector<HTMLElement>('[data-vergangen]');
    const anzahl = Number(box.dataset.anzahl) || Infinity;
    let n = 0;
    const alt: HTMLElement[] = [];
    kommend.querySelectorAll<HTMLElement>('.termin').forEach((t) => {
      const status = t.querySelector<HTMLElement>('[data-status]')!;
      if (t.dataset.bis! < heute) {
        status.textContent = 'Vorbei';
        alt.push(t);
      } else if (++n > anzahl) t.remove();
      else if (t.dataset.von! <= heute) {
        status.textContent = 'Heute';
        status.classList.add('heute');
      }
    });
    alt.reverse().forEach((t) => {
      t.classList.add('vorbei');
      if (vergangen) vergangen.append(t);
      else t.remove();
    });
    if (n === 0) box.querySelector<HTMLElement>('[data-leer]')!.hidden = false;
    if (vergangen && alt.length) box.querySelector<HTMLElement>('[data-vergangen-box]')!.hidden = false;
  });
</script>
