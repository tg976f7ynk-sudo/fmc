---
import { getImage } from 'astro:assets';
import { alleTermine, isoTag, zeitraum } from '../lib/inhalte';

interface Props { modus?: 'kommend' | 'alle'; anzahl?: number; }
const { modus = 'alle', anzahl = 0 } = Astro.props;
const termine = await Promise.all(
  (await alleTermine()).map(async (t) => ({
    ...t,
    vorschau: t.data.bild ? await getImage({ src: t.data.bild, width: 160, height: 160, fit: 'cover', format: 'webp', quality: 70, layout: 'none' }) : null,
  })),
);
const monat = new Intl.DateTimeFormat('de-DE', { month: 'short', timeZone: 'UTC' });
---

<div class="terminliste" data-modus={modus} data-anzahl={anzahl}>
  <ul class="termine" data-kommend>
    {
      termine.map((t) => (
        <li class="termin" data-bis={isoTag(t.data.ende ?? t.data.datum)}>
          <div class="termin-tag">
            <b>{t.data.datum.getUTCDate()}</b>
            <span>{monat.format(t.data.datum).replace('.', '')} {String(t.data.datum.getUTCFullYear()).slice(2)}</span>
          </div>
          <div>
            <h3>{t.data.link ? <a href={t.data.link}>{t.data.titel}</a> : t.data.titel}</h3>
            <p>
              {zeitraum(t.data.datum, t.data.ende)}
              {t.data.uhrzeit && ` · ${t.data.uhrzeit}`}
              {t.data.ort && ` · ${t.data.ort}`}
            </p>
            {t.data.beschreibung && <p>{t.data.beschreibung}</p>}
            {t.data.anmeldung && (
              <div class="termin-anmelden" data-schluss={t.data.anmeldeschluss ? isoTag(t.data.anmeldeschluss) : undefined} data-grenze={t.data.plaetze || t.data.geraete ? t.id : undefined}>
                <a class="knopf klein" href={`/termine/anmeldung/?termin=${t.id}`}>Jetzt anmelden</a>
                <span class="termin-frei" data-frei hidden></span>
              </div>
            )}
          </div>
          {t.vorschau && t.data.bild && (
            <a class="termin-bild" href={t.data.bild.src} data-bild>
              <img src={t.vorschau.src} width="80" height="80" alt={t.data.bild_alt || `Bild zum Termin „${t.data.titel}“`} loading="lazy" decoding="async" />
            </a>
          )}
        </li>
      ))
    }
  </ul>
  <p class="leer" data-leer hidden>Zurzeit sind keine kommenden Termine eingetragen.</p>
  {
    modus === 'alle' && (
      <details class="vergangen" data-vergangen-box hidden>
        <summary>Vergangene Termine anzeigen</summary>
        <ul class="termine" data-vergangen />
      </details>
    )
  }
</div>

<script>
  // Welche Termine "kommend" sind, entscheidet das Datum des Besuchers –
  // so stimmt die Liste auch ohne tägliche Neuveröffentlichung.
  const heute = new Date().toLocaleDateString('sv-SE', { timeZone: 'Europe/Berlin' });
  document.querySelectorAll<HTMLElement>('.terminliste').forEach((box) => {
    const kommend = box.querySelector<HTMLElement>('[data-kommend]')!;
    const vergangen = box.querySelector<HTMLElement>('[data-vergangen]');
    const anzahl = Number(box.dataset.anzahl) || Infinity;
    let n = 0;
    const alt: HTMLElement[] = [];
    kommend.querySelectorAll<HTMLElement>('.termin').forEach((t) => {
      if (t.dataset.bis! < heute) alt.push(t);
      else if (++n > anzahl) t.remove();
    });
    alt.reverse().forEach((t) => {
      t.classList.add('vorbei');
      if (vergangen) vergangen.append(t);
      else t.remove();
    });
    // Anmeldung nach dem Anmeldeschluss ausblenden
    box.querySelectorAll<HTMLElement>('[data-schluss]').forEach((a) => {
      if (a.dataset.schluss! < heute) a.remove();
    });
    if (n === 0) box.querySelector<HTMLElement>('[data-leer]')!.hidden = false;
    if (vergangen && alt.length) box.querySelector<HTMLElement>('[data-vergangen-box]')!.hidden = false;
  });

  // Freie Plätze bei Terminen mit Teilnehmergrenze (nur Zahlen, keine Namen)
  const mitGrenze = [...document.querySelectorAll<HTMLElement>('.terminliste [data-kommend] [data-grenze]')];
  if (mitGrenze.length) {
    fetch('/api/anmeldung/plaetze')
      .then((r) => r.json())
      .then(({ termine }) => {
        for (const el of mitGrenze) {
          const p = termine?.[el.dataset.grenze!];
          if (!p) continue;
          const anzeige = el.querySelector<HTMLElement>('[data-frei]')!;
          const zeile = (frei: number, max: number, was: string) => {
            const z = document.createElement('span');
            z.className = 'termin-frei-zeile';
            const balken = document.createElement('span');
            balken.className = 'platzbalken';
            balken.style.setProperty('--anteil', `${Math.round(((max - frei) / max) * 100)}%`);
            balken.append(document.createElement('span'));
            z.append(balken, frei === 0 ? `${was}: ausgebucht` : `${was}: noch ${frei} von ${max} frei`);
            if (frei === 0) z.classList.add('voll');
            else if (frei / max <= 0.2) z.classList.add('knapp');
            return z;
          };
          if (p.frei === 0) {
            el.querySelector('a')?.remove();
            anzeige.append(zeile(0, p.plaetze, 'Plätze'));
          } else {
            if (p.frei != null) anzeige.append(zeile(p.frei, p.plaetze, 'Plätze'));
            if (p.geraeteFrei != null) anzeige.append(zeile(p.geraeteFrei, p.geraete, 'Fluggeräte'));
          }
          anzeige.hidden = false;
        }
      })
      .catch(() => {});
  }
</script>
