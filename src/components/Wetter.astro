---
// Wetter am Platz als Instrumentenpanel: Windkompass, Böenmesser, Werte, Stundenstreifen.
interface Props { ausfuehrlich?: boolean; }
const { ausfuehrlich = false } = Astro.props;
const striche = Array.from({ length: 36 }, (_, i) => i * 10);
---

<div class="wetter" data-ausfuehrlich={ausfuehrlich ? '1' : ''}>
  <p class="leer" data-status>Wetterdaten werden geladen …</p>
  <div data-inhalt hidden>
    <div class="instrumente">
      <figure class="kompass" aria-hidden="true">
        <svg viewBox="0 0 200 200">
          <circle cx="100" cy="100" r="92" class="kompass-ring" />
          {striche.map((g) => (
            <line x1="100" y1={g % 90 === 0 ? 10 : g % 30 === 0 ? 14 : 17} x2="100" y2="22" transform={`rotate(${g} 100 100)`} class={g % 30 === 0 ? 'strich lang' : 'strich'} />
          ))}
          <text x="100" y="40" class="himmelsrichtung">N</text>
          <text x="164" y="105" class="himmelsrichtung">O</text>
          <text x="100" y="170" class="himmelsrichtung">S</text>
          <text x="36" y="105" class="himmelsrichtung">W</text>
          <g class="nadel" data-nadel>
            <polygon points="100,26 108,100 100,92 92,100" class="nadel-spitze" />
            <polygon points="100,174 106,104 100,110 94,104" class="nadel-ende" />
          </g>
          <circle cx="100" cy="100" r="30" class="kompass-mitte" />
          <text x="100" y="100" class="kompass-wert" data-kompass-wert>–</text>
          <text x="100" y="116" class="kompass-einheit">km/h</text>
        </svg>
        <figcaption>Wind aus <span data-kompass-richtung>–</span></figcaption>
      </figure>
      <div class="instrumente-rechts">
        <div class="wetter-jetzt">
          <span class="wetter-temp" data-temp></span>
          <div>
            <strong data-lage></strong><br />
            <span class="ampel" data-ampel></span>
          </div>
        </div>
        <div class="boeenmesser">
          <div class="boeenmesser-kopf"><span>Böen</span><b data-boeen></b></div>
          <div class="boeenmesser-skala"><span class="boeenmesser-marke" data-boeen-marke></span></div>
          <div class="boeenmesser-zahlen" aria-hidden="true"><span>0</span><span>20</span><span>40</span><span>60 km/h</span></div>
        </div>
      </div>
    </div>
    <dl class="wetter-werte">
      <div><dt>Wind aus</dt><dd data-wind></dd></div>
      <div><dt>Niederschlag</dt><dd data-regen></dd></div>
      <div><dt>Bewölkung</dt><dd data-wolken></dd></div>
      <div><dt>Luftdruck</dt><dd data-druck></dd></div>
      <div><dt>Sicht</dt><dd data-sicht></dd></div>
      <div><dt>Sonnenuntergang</dt><dd data-sonne></dd></div>
    </dl>
    <div class="wetter-stunden" data-stunden aria-label="Vorhersage für die nächsten Stunden"></div>
    {ausfuehrlich && <table class="wetter-tage"><thead><tr><th>Tag</th><th>Wetter</th><th>Temperatur</th><th>Wind / Böen</th><th>Regen</th><th>Sonne</th></tr></thead><tbody data-tage></tbody></table>}
    <p class="quelle">Vorhersage für den Flugplatz · Quelle: <a href="https://open-meteo.com/" rel="noopener">Open-Meteo</a> · Stand <span data-stand></span> Uhr. Maßgeblich bleibt die Lage vor Ort.</p>
  </div>
</div>

<script>
  import { holeWetter, LAGE, richtung, pfeil, rund, uhrzeit } from '../scripts/wetter-daten';

  document.querySelectorAll<HTMLElement>('.wetter').forEach(async (box) => {
    const q = (s: string) => box.querySelector<HTMLElement>(`[data-${s}]`)!;
    try {
      const w = await holeWetter();
      const j = w.current;
      q('temp').textContent = `${rund(j.temperature_2m)} °C`;
      q('lage').textContent = LAGE[j.weather_code] ?? '';
      q('wind').innerHTML = `${pfeil(j.wind_direction_10m)}${rund(j.wind_speed_10m)} km/h ${richtung(j.wind_direction_10m)}`;
      q('boeen').textContent = `${rund(j.wind_gusts_10m)} km/h`;
      q('regen').textContent = `${j.precipitation.toLocaleString('de-DE')} mm`;
      q('wolken').textContent = `${rund(j.cloud_cover)} %`;
      q('druck').textContent = j.pressure_msl ? `${rund(j.pressure_msl)} hPa` : '–';
      q('sicht').textContent = j.visibility ? `${(j.visibility / 1000).toLocaleString('de-DE', { maximumFractionDigits: 0 })} km` : '–';
      q('sonne').textContent = w.daily?.sunset?.[0] ? `${uhrzeit(w.daily.sunset[0])} Uhr` : '–';
      q('kompass-wert').textContent = String(rund(j.wind_speed_10m));
      q('kompass-richtung').textContent = richtung(j.wind_direction_10m);
      // Nadel zeigt, woher der Wind kommt
      q('nadel').style.setProperty('--grad', `${j.wind_direction_10m}deg`);
      q('boeen-marke').style.setProperty('--wert', `${Math.min(100, (j.wind_gusts_10m / 60) * 100)}%`);

      const ampel = q('ampel');
      const boe = j.wind_gusts_10m;
      const nass = j.precipitation > 0.1 || j.weather_code >= 51;
      const [farbe, text] =
        boe >= 40 || j.weather_code >= 95 ? ['#ff5a4f', 'Stürmisch'] : boe >= 25 || nass ? ['#ffb020', nass ? 'Nass oder böig' : 'Böiger Wind'] : ['#35d07f', 'Ruhige Bedingungen'];
      ampel.style.setProperty('--farbe', farbe);
      ampel.textContent = text;
      q('stand').textContent = uhrzeit(j.time);

      const jetzt = j.time.slice(0, 13);
      const start = Math.max(0, w.hourly.time.findIndex((t: string) => t.slice(0, 13) >= jetzt));
      const anzahl = box.dataset.ausfuehrlich ? 24 : 10;
      q('stunden').innerHTML = w.hourly.time
        .slice(start + 1, start + 1 + anzahl)
        .map((t: string, k: number) => {
          const i = start + 1 + k;
          return `<div><span>${t.slice(11, 16)}</span><b>${rund(w.hourly.temperature_2m[i])}°</b>${pfeil(w.hourly.wind_direction_10m[i])}${rund(w.hourly.wind_speed_10m[i])}<br><small>Böen ${rund(w.hourly.wind_gusts_10m[i])}</small></div>`;
        })
        .join('');

      const tage = box.querySelector<HTMLElement>('[data-tage]');
      if (tage) {
        const d = w.daily;
        tage.innerHTML = d.time
          .map((t: string, i: number) => {
            const tag = new Date(t + 'T12:00').toLocaleDateString('de-DE', { weekday: 'short', day: 'numeric', month: 'numeric' });
            return `<tr><td>${tag}</td><td>${LAGE[d.weather_code[i]] ?? ''}</td><td>${rund(d.temperature_2m_min[i])}° / ${rund(d.temperature_2m_max[i])}°</td><td>${pfeil(d.wind_direction_10m_dominant[i])}${rund(d.wind_speed_10m_max[i])} / ${rund(d.wind_gusts_10m_max[i])} km/h</td><td>${d.precipitation_sum[i].toLocaleString('de-DE')} mm</td><td>${d.sunrise ? `${uhrzeit(d.sunrise[i])}–${uhrzeit(d.sunset[i])}` : ''}</td></tr>`;
          })
          .join('');
      }
      q('status').hidden = true;
      q('inhalt').hidden = false;
    } catch {
      q('status').textContent = 'Die Wetterdaten sind im Moment nicht verfügbar.';
    }
  });
</script>
