---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import logo from '../assets/logo.jpg';
import seite from '../data/einstellungen.json';
import nav from '../data/navigation.json';

interface Props {
  titel?: string;
  beschreibung?: string;
  bild?: string;
  artikel?: boolean;
  // nicht in Suchmaschinen (z. B. Anmeldeseite)
  versteckt?: boolean;
}
const { titel, beschreibung = seite.beschreibung, bild, artikel = false, versteckt = false } = Astro.props;
const volltitel = titel ? `${titel} – ${seite.kurzname}` : `${seite.name} – seit 1971`;
const logoKlein = await getImage({ src: logo, width: 120, height: 120, format: 'webp', layout: 'none' });
const pfad = Astro.url.pathname;
const aktiv = (link: string) => (link === '/' ? pfad === '/' : pfad.startsWith(link));
const kanonisch = new URL(pfad, Astro.site);
const ogBild = bild ? new URL(bild, Astro.site).href : undefined;
const jahr = new Date().getFullYear();
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {versteckt && <meta name="robots" content="noindex, nofollow" />}
    <title>{volltitel}</title>
    <meta name="description" content={beschreibung} />
    <link rel="canonical" href={kanonisch} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="text/markdown" title="Inhalte für Sprachmodelle" href="/llms.txt" />
    <link rel="alternate" type="application/rss+xml" title={`${seite.kurzname} – Aktuelles`} href="/rss.xml" />
    <meta name="theme-color" content="#0b5cab" />
    <meta property="og:site_name" content={seite.name} />
    <meta property="og:title" content={titel ?? seite.name} />
    <meta property="og:description" content={beschreibung} />
    <meta property="og:type" content={artikel ? 'article' : 'website'} />
    <meta property="og:url" content={kanonisch} />
    <meta property="og:locale" content="de_DE" />
    {ogBild && <meta property="og:image" content={ogBild} />}
  </head>
  <body>
    <a class="skip" href="#inhalt">Zum Inhalt springen</a>
    <header class="kopf">
      <div class="container kopf-innen">
        <a class="marke" href="/" aria-label={`${seite.name} – Startseite`}>
          <img src={logoKlein.src} width="52" height="52" alt="" />
          <span class="marke-text">
            <strong>{seite.kurzname}</strong>
            <span>Flug- und Modellbau Club e.V. · seit 1971</span>
          </span>
        </a>
        <a class="kopf-suche" href="/suche/" aria-label="Suche" title="Suche">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2.2" /><path d="m15.5 15.5 5 5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" /></svg>
        </a>
        <button class="menue-knopf" type="button" aria-expanded="false" aria-controls="hauptmenue">
          <span class="striche" aria-hidden="true"></span> Menü
        </button>
        <nav class="nav" id="hauptmenue" aria-label="Hauptmenü">
          <ul>
            {
              nav.haupt.map((p: any) => (
                <li>
                  <a href={p.link} aria-current={aktiv(p.link) && !p.unterpunkte ? 'page' : undefined}>
                    {p.titel}
                    {p.unterpunkte?.length > 0 && <span class="pfeil" aria-hidden="true" />}
                  </a>
                  {p.unterpunkte?.length > 0 && (
                    <ul class="unter">
                      {p.unterpunkte.map((u: any) => (
                        <li>
                          <a href={u.link} aria-current={pfad === u.link ? 'page' : undefined}>
                            {u.titel}
                          </a>
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="inhalt">
      <slot />
    </main>

    <footer class="fuss">
      <div class="container">
        <div class="fuss-raster">
          <div>
            <h2>{seite.name}</h2>
            <address>{seite.anschrift}</address>
            <p style="margin-top:.7rem">
              <a href={`mailto:${seite.email}`}>{seite.email}</a>
            </p>
          </div>
          <div>
            <h2>Verein</h2>
            <ul>
              <li><a href="/ueber-uns/">Über uns</a></li>
              <li><a href="/gastpiloten/">Gastpiloten</a></li>
              <li><a href="/jugend/">Jugend</a></li>
              <li><a href="/termine/">Termine</a></li>
            </ul>
          </div>
          <div>
            <h2>Rechtliches</h2>
            <ul>
              {nav.fuss.map((p: any) => <li><a href={p.link}>{p.titel}</a></li>)}
            </ul>
          </div>
        </div>
        <div class="unten">
          <span>© {jahr} {seite.name}</span>
          <a href="/rss.xml">Neuigkeiten als RSS-Feed</a>
        </div>
      </div>
    </footer>

    <div class="lb" role="dialog" aria-modal="true" aria-label="Bildansicht" hidden>
      <button class="zu" type="button" aria-label="Schließen">×</button>
      <button class="zurueck" type="button" aria-label="Vorheriges Bild">‹</button>
      <img alt="" />
      <button class="vor" type="button" aria-label="Nächstes Bild">›</button>
      <span class="zaehler"></span>
    </div>

    <script>
      // ---- Anonyme Zählung des Seitenaufrufs (keine Cookies, nichts wird im Browser gespeichert)
      if (!navigator.webdriver && !/^\/(admin|mitglieder)\//.test(location.pathname)) {
        const melden = () => navigator.sendBeacon?.('/api/zaehler', JSON.stringify({ p: location.pathname }));
        if (document.visibilityState === 'visible') melden();
        else document.addEventListener('visibilitychange', () => document.visibilityState === 'visible' && melden(), { once: true });
      }

      // ---- Menü (mobil)
      const knopf = document.querySelector<HTMLButtonElement>('.menue-knopf');
      const nav = document.querySelector<HTMLElement>('.nav');
      knopf?.addEventListener('click', () => {
        const offen = nav!.classList.toggle('offen');
        knopf.setAttribute('aria-expanded', String(offen));
      });

      // ---- Videos erst nach Klick laden (Datenschutz)
      document.querySelectorAll<HTMLElement>('.video[data-youtube]').forEach((v) => {
        v.querySelector('button')?.addEventListener('click', () => {
          const f = document.createElement('iframe');
          f.src = `https://www.youtube-nocookie.com/embed/${v.dataset.youtube}?autoplay=1&rel=0`;
          f.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
          f.allowFullscreen = true;
          f.title = 'YouTube-Video';
          v.replaceChildren(f);
        });
      });

      // ---- Bildansicht (Lightbox)
      const lb = document.querySelector<HTMLElement>('.lb')!;
      const lbBild = lb.querySelector('img')!;
      const zaehler = lb.querySelector('.zaehler')!;
      let gruppe: { src: string; alt: string }[] = [];
      let pos = 0;
      let zurueckZu: HTMLElement | null = null;

      const groesstes = (img: HTMLImageElement) => {
        const kandidaten = (img.getAttribute('srcset') || '')
          .split(',')
          .map((s) => s.trim().split(/\s+/))
          .filter((k) => k[0])
          .map(([url, w]) => ({ url, w: parseInt(w) || 0 }))
          .sort((a, b) => b.w - a.w);
        return kandidaten[0]?.url || img.currentSrc || img.src;
      };
      const zeige = (i: number) => {
        pos = (i + gruppe.length) % gruppe.length;
        lbBild.src = gruppe[pos].src;
        lbBild.alt = gruppe[pos].alt;
        zaehler.textContent = gruppe.length > 1 ? `${pos + 1} / ${gruppe.length}` : '';
        lb.querySelectorAll<HTMLElement>('.vor, .zurueck').forEach((b) => (b.style.display = gruppe.length > 1 ? '' : 'none'));
        if (gruppe.length > 1) new Image().src = gruppe[(pos + 1) % gruppe.length].src;
      };
      const oeffne = (g: typeof gruppe, i: number, von: HTMLElement) => {
        gruppe = g;
        zurueckZu = von;
        lb.hidden = false;
        lb.classList.add('offen');
        document.body.style.overflow = 'hidden';
        zeige(i);
        lb.querySelector<HTMLElement>('.zu')!.focus();
      };
      const schliesse = () => {
        lb.classList.remove('offen');
        lb.hidden = true;
        lbBild.removeAttribute('src');
        document.body.style.overflow = '';
        zurueckZu?.focus();
      };
      document.addEventListener('click', (e) => {
        const ziel = e.target as HTMLElement;
        const link = ziel.closest<HTMLAnchorElement>('a[data-bild]');
        if (link) {
          e.preventDefault();
          const alle = [...(link.closest('[data-galerie]') ?? document).querySelectorAll<HTMLAnchorElement>('a[data-bild]')];
          oeffne(alle.map((a) => ({ src: a.href, alt: a.querySelector('img')?.alt ?? '' })), alle.indexOf(link), link);
          return;
        }
        const img = ziel.closest<HTMLImageElement>('.prose img, .titelbild img');
        if (img && !img.closest('a')) {
          const alle = [...document.querySelectorAll<HTMLImageElement>('.titelbild img, .prose img')].filter((i) => !i.closest('a'));
          oeffne(alle.map((i) => ({ src: groesstes(i), alt: i.alt })), alle.indexOf(img), img);
        }
      });
      lb.addEventListener('click', (e) => {
        const z = e.target as HTMLElement;
        if (z.closest('.vor')) zeige(pos + 1);
        else if (z.closest('.zurueck')) zeige(pos - 1);
        else if (z !== lbBild) schliesse();
      });
      document.addEventListener('keydown', (e) => {
        if (lb.hidden) return;
        if (e.key === 'Escape') schliesse();
        if (e.key === 'ArrowRight') zeige(pos + 1);
        if (e.key === 'ArrowLeft') zeige(pos - 1);
      });
      let startX = 0;
      lb.addEventListener('touchstart', (e) => (startX = e.touches[0].clientX), { passive: true });
      lb.addEventListener('touchend', (e) => {
        const dx = e.changedTouches[0].clientX - startX;
        if (Math.abs(dx) > 50) zeige(pos + (dx < 0 ? 1 : -1));
      });
    </script>
  </body>
</html>
