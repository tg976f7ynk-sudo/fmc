---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Basis from '../../layouts/Basis.astro';
import Seitenkopf from '../../components/Seitenkopf.astro';
import Galerie from '../../components/Galerie.astro';
import { alleBeitraege, beitragSlug, beitragUrl, datumLang, isoTag, kategorieUrl, kurztext } from '../../lib/inhalte';

export const getStaticPaths = (async () => {
  const beitraege = await alleBeitraege();
  return beitraege.map((beitrag, i) => ({
    params: { slug: beitragSlug(beitrag) },
    props: { beitrag, neuer: beitraege[i - 1], aelter: beitraege[i + 1] },
  }));
}) satisfies GetStaticPaths;

const { beitrag, neuer, aelter } = Astro.props;
const d = beitrag.data;
const { Content } = await render(beitrag);
// Dateiname des Titelbilds (ohne Kennung und Endung), um es im Text nicht doppelt zu zeigen
const titelStamm = d.titelbild?.src?.split('/').pop()?.split('?')[0].replace(/\.[A-Za-z0-9_-]{6,}(_[A-Za-z0-9]+)?\.\w+$/, '') ?? '';
---

<Basis titel={d.titel} beschreibung={kurztext(beitrag, 155)} bild={d.titelbild?.src} artikel>
  {
    d.titelbild ? (
      <header class="beitragskopf">
        <Image src={d.titelbild} alt="" widths={[640, 1024, 1600, 2000]} sizes="100vw" layout="full-width" loading="eager" quality={72} />
        <div class="container">
          <nav class="pfad" aria-label="Sie sind hier"><a href="/">Startseite</a> / <a href="/aktuelles/">Aktuelles</a></nav>
          <h1>{d.titel}</h1>
          <div class="meta">
            <time datetime={isoTag(d.datum)}>{datumLang(d.datum)}</time>
            {d.kategorien.map((k) => <a class="marke-kat" href={kategorieUrl(k)}>{k}</a>)}
          </div>
        </div>
      </header>
    ) : (
      <Seitenkopf titel={d.titel} pfad={[{ titel: 'Aktuelles', link: '/aktuelles/' }]}>
        <div class="meta" style="margin-top:.8rem">
          <time datetime={isoTag(d.datum)}>{datumLang(d.datum)}</time>
          {d.kategorien.map((k) => <a class="marke-kat" href={kategorieUrl(k)}>{k}</a>)}
        </div>
      </Seitenkopf>
    )
  }
  <article class="abschnitt" data-titelbild={titelStamm}>
    <div class="schmal">
      <div class="prose"><Content /></div>
      <Galerie bilder={d.bilder} titel={d.titel} />
      <nav class="weiter" aria-label="Weitere Beiträge">
        <span>{aelter && <a href={beitragUrl(aelter)}><small>← Älterer Beitrag</small>{aelter.data.titel}</a>}</span>
        <span class="rechts">{neuer && <a href={beitragUrl(neuer)}><small>Neuerer Beitrag →</small>{neuer.data.titel}</a>}</span>
      </nav>
    </div>
  </article>
</Basis>

<script>
  // Das Titelbild steht schon groß im Kopf – im Text nicht noch einmal zeigen.
  document.querySelectorAll<HTMLElement>('article[data-titelbild]').forEach((artikel) => {
    const stamm = artikel.dataset.titelbild;
    if (!stamm) return;
    const bild = [...artikel.querySelectorAll<HTMLImageElement>('.prose img')].find((i) => (i.currentSrc || i.src).includes(`/${stamm}.`));
    if (!bild) return;
    const huelle = bild.closest('.bild');
    if (huelle) huelle.remove();
    else bild.remove();
  });
</script>
