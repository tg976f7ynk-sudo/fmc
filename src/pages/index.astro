---
import { Image } from 'astro:assets';
import Basis from '../layouts/Basis.astro';
import BeitragKarte from '../components/BeitragKarte.astro';
import TerminListe from '../components/TerminListe.astro';
import Wetter from '../components/Wetter.astro';
import flugplatz from '../assets/flugplatz.jpg';
import seite from '../data/einstellungen.json';
import { alleBeitraege } from '../lib/inhalte';

const beitraege = (await alleBeitraege()).slice(0, 6);
---

<Basis>
  <section class="buehne">
    <Image src={flugplatz} alt="" widths={[640, 1024, 1600, 2000]} sizes="100vw" layout="full-width" loading="eager" fetchpriority="high" quality={70} />
    <div class="container">
      <div class="buehne-innen">
        <span class="seit">Seit 1971</span>
        <h1>{seite.name}</h1>
        <p>Modellflug mit Motor-, Segel-, Jet-, Hubschrauber- und Wasserflugmodellen – mitten im Rhein-Main-Gebiet. Gäste und Nachwuchspiloten sind herzlich willkommen.</p>
        <div class="knoepfe">
          <a class="knopf gelb" href="/gastpiloten/">Als Gast fliegen</a>
          <a class="knopf umriss" href="/ueber-uns/">Der Verein</a>
        </div>
      </div>
    </div>
  </section>

  <section class="abschnitt">
    <div class="container">
      <div class="abschnitt-kopf">
        <h2>Aktuelles</h2>
        <a class="mehr" href="/aktuelles/">Alle Beiträge</a>
      </div>
      <div class="karten">
        {beitraege.map((b) => <BeitragKarte beitrag={b} />)}
      </div>
    </div>
  </section>

  <section class="abschnitt weiss">
    <div class="container zwei-spalten">
      <div>
        <div class="abschnitt-kopf">
          <h2>Nächste Termine</h2>
          <a class="mehr" href="/termine/">Alle Termine</a>
        </div>
        <TerminListe modus="kommend" anzahl={4} />
      </div>
      <div>
        <div class="abschnitt-kopf">
          <h2>Wetter am Platz</h2>
          <a class="mehr" href="/wetter/">Vorhersage</a>
        </div>
        <div class="box"><Wetter /></div>
      </div>
    </div>
  </section>

  <section class="abschnitt">
    <div class="container">
      <div class="abschnitt-kopf"><h2>Schnell gefunden</h2></div>
      <div class="kacheln">
        <a class="kachel" href="/gastpiloten/"><strong>Gastpiloten</strong><span>Was Gäste vor dem ersten Flug wissen müssen</span></a>
        <a class="kachel" href="/anfahrt/"><strong>Anfahrt</strong><span>So finden Sie unseren Flugplatz</span></a>
        <a class="kachel" href="/jugend/"><strong>Jugend</strong><span>Modellbau und Fliegen lernen im Verein</span></a>
        <a class="kachel" href="/impressionen/"><strong>Impressionen</strong><span>Bilder und Videos unserer Veranstaltungen</span></a>
        <a class="kachel" href="/downloads/"><strong>Downloads</strong><span>Flugplatzordnung, Aufnahmeantrag und mehr</span></a>
        <a class="kachel" href="/kontakt/"><strong>Kontakt</strong><span>Fragen? Schreiben Sie uns</span></a>
      </div>
    </div>
  </section>
</Basis>
